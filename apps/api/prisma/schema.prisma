// Nexo — core data model.
//
// Organization is the tenant boundary: every business entity belongs to one.
// See docs/DATABASE.md for the rationale and the entity reference.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // The connection URL lives in prisma.config.ts (Prisma 7 moved it out of the schema).
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

enum ClientType {
  PERSON
  COMPANY
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

/// Shared by Project and Task: the scale is identical, so it is modelled once.
enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

/// A company or team using Nexo. The tenant boundary for every other entity.
model Organization {
  id     String             @id @default(uuid()) @db.Uuid
  name   String
  slug   String             @unique
  status OrganizationStatus @default(ACTIVE)

  /// Monotonic counter behind human-readable project codes (NEX-001, NEX-002…).
  /// Incremented atomically inside the transaction that creates a project, so
  /// concurrent creates can never collide and a number is never reused — not
  /// even when the most recent project is deleted.
  projectCodeSequence Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  clients     Client[]
  projects    Project[]
  tasks       Task[]
  sessions    Session[]
}

/// A person who uses Nexo. Credentials are deliberately absent until phase 4.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  firstName    String
  lastName     String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  /// Argon2id hash. Nullable: an invited user exists before setting a password.
  /// Never leaves the backend.
  passwordHash String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships        Membership[]
  projectMemberships ProjectMember[]
  assignedTasks      Task[]
  sessions           Session[]
}

/// Links a User to an Organization with a role.
model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  userId         String         @db.Uuid
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user cannot join the same organization twice. This composite unique also
  // serves lookups by organizationId, so no separate index is needed for it.
  @@unique([organizationId, userId])
  // "Which organizations does this user belong to?"
  @@index([userId])
}

/// A customer of the organization.
model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  type           ClientType   @default(COMPANY)
  name           String
  documentType   String?
  documentNumber String?
  email          String?
  phone          String?
  address        String?
  /// A client is a prospect until there is real work; marking them ACTIVE
  /// on creation would overstate the relationship.
  status         ClientStatus @default(PROSPECT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  // A document number identifies a client within its organization, never
  // globally: two organizations may legitimately deal with the same company.
  // documentNumber is nullable and PostgreSQL treats each NULL as distinct, so
  // any number of clients without a document still coexist. This also replaces
  // the former plain index — a unique constraint is backed by one.
  @@unique([organizationId, documentNumber])
  // Every index leads with organizationId, so each also covers plain tenant
  // scoping; a bare column index would never be used.
  @@index([organizationId, name])
  // Default list ordering: newest first within the organization.
  @@index([organizationId, createdAt])
  // The status filter is the selective one. `type` is deliberately not indexed:
  // with two possible values it would barely narrow anything the
  // organizationId prefix has not already narrowed.
  @@index([organizationId, status])
}

/// Work delivered by the organization, optionally for a client.
model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  clientId       String?       @db.Uuid
  name           String
  code           String
  description    String?
  status         ProjectStatus @default(PLANNING)
  priority       Priority      @default(MEDIUM)
  startDate      DateTime?
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  tasks        Task[]

  // Human-readable codes (e.g. NEX-001) are unique per organization, not globally.
  // Also covers tenant scoping by prefix.
  @@unique([organizationId, code])
  @@index([organizationId, status])
  // Default list ordering: newest first within the organization.
  @@index([organizationId, createdAt])
  // "What is due soon" is the operational question this module exists to answer.
  @@index([organizationId, dueDate])
  @@index([clientId])
}

/// A user assigned to a project. Intentionally has no role of its own yet.
model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

/// A unit of work inside a project.
model Task {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  projectId      String     @db.Uuid
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  assigneeId     String?    @db.Uuid
  /// Manual ordering slot for a future Kanban board.
  position       Int        @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee     User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  // Kanban read path: a project's board, by column, in order.
  @@index([projectId, status, position])
  @@index([organizationId, status])
  @@index([assigneeId])
}

/// A refresh-token session. One row per active login, per organization context.
/// The refresh token itself is never stored: only a SHA-256 fingerprint.
model Session {
  id             String @id @default(uuid()) @db.Uuid
  userId         String @db.Uuid
  organizationId String @db.Uuid

  /// SHA-256 of the current refresh token. Rotated on every refresh.
  refreshTokenHash String

  userAgent String?
  ipAddress String?

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // "Revoke every session of this user" (logout-all).
  @@index([userId])
  // Sessions scoped to an organization.
  @@index([organizationId])
  // Future cleanup job: delete rows whose expiresAt has passed.
  @@index([expiresAt])
}
