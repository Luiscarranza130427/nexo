# Port the Nexo API listens on. The code falls back to 3001 when unset.
PORT=3001
NODE_ENV=development

# PostgreSQL connection string. Replace USER and PASSWORD with your own local
# credentials — this file holds example values only and is committed to Git.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/nexo_dev?schema=public"

# Isolated database used by automated tests. Never point this at nexo_dev:
# the test suite truncates data between runs.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5434/nexo_test?schema=public"
