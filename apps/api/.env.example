# Port the Nexo API listens on. The code falls back to 3001 when unset.
PORT=3001
NODE_ENV=development

# PostgreSQL connection string. Replace USER and PASSWORD with your own local
# credentials — this file holds example values only and is committed to Git.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/nexo_dev?schema=public"

# Isolated database used by automated tests. Never point this at nexo_dev:
# the test suite truncates data between runs.
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5434/nexo_test?schema=public"

# Access and refresh tokens are signed with DIFFERENT secrets on purpose: a
# leaked access secret must not allow minting refresh tokens. Generate real ones
# with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-secure-secret
JWT_REFRESH_SECRET=replace-with-secure-secret

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Allowed browser origin for CORS. Credentials are enabled, so this is never "*".
FRONTEND_URL=http://localhost:3000

# Set to true in production so the refresh cookie is HTTPS-only.
COOKIE_SECURE=false

# Refresh-cookie SameSite policy. Depends on the deployment topology:
# "lax" when the frontend and API share a site (including localhost on two
# ports); "none" when they are cross-site, which browsers only accept together
# with COOKIE_SECURE=true. See docs/SECURITY.md.
COOKIE_SAMESITE=lax

# Days an invitation link stays valid (whole number, 1–90). Defaults to 7.
INVITATION_TTL_DAYS=7

# Disables rate limiting. Set ONLY by the automated test runner, never in a
# real environment — it turns off brute-force protection entirely.
THROTTLE_DISABLED=false

# Only needed while bootstrapping the first OWNER password. Leave the password
# empty here and set it in your local .env, then clear it once the script ran.
# See docs/AUTHENTICATION.md.
BOOTSTRAP_OWNER_EMAIL=dev@novatec.local
BOOTSTRAP_OWNER_PASSWORD=
