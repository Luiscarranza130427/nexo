# ---------------------------------------------------------------------------
# Nexo — monorepo gitignore
# NOTE: pnpm-lock.yaml is intentionally NOT ignored. It must stay versioned.
# ---------------------------------------------------------------------------

# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/

# Compiler / tooling caches
*.tsbuildinfo
.eslintcache

# Test and coverage output
coverage/
.nyc_output/

# Environment files — never commit real secrets.
.env
.env.local
.env.*.local
# The templates must stay versioned.
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Generated and mutated by Next.js; regenerated by `next typegen`.
next-env.d.ts

# Prisma Client is generated from schema.prisma; never versioned.
apps/api/src/generated/
